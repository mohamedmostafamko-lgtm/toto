rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function me() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }
    function role() {
      return me().get('disabled', false) == true ? 'none' : me().role;
    }
    function canManage(storeId) {
      return role() == 'admin' || (role() == 'merchant' && me().storeId == storeId);
    }

    // صور المتاجر: القراءة لأي مستخدم مسجل، والرفع للأدمن أو لتاجر المتجر نفسه، صور فقط وأقل من 2 ميجا
    match /stores/{storeId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
                            && request.resource.size < 2 * 1024 * 1024
                            && request.resource.contentType.matches('image/.*')
                            && canManage(storeId);
      allow delete: if request.auth != null && canManage(storeId);
    }

    // صور المنتجات
    match /products/{storeId}/{file} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.contentType.matches('image/.*')
                    && request.resource.size < 1024 * 1024
                    && canManage(storeId);
      allow delete: if request.auth != null && canManage(storeId);
      allow update: if false;
    }

    // توقيعات التسليم (PNG): المندوب يرفع مرة واحدة ومينفعش تتعدّل
    match /signatures/{orderId}/{file} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.contentType == 'image/png'
                    && request.resource.size < 500 * 1024
                    && role() == 'courier';
      allow update, delete: if false;
    }
  }
}
